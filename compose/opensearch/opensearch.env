# Variables for the OPTIONAL OpenSearch path (profile `opensearch`).
#
# This file documents and centralizes the variables of the optional service. It
# is NOT needed for the pandas path: the analyses and tests run 100% offline,
# without OpenSearch.
#
# How to use (optional): load these variables into your shell before running the
# ingest from the host, for example in PowerShell:
#   Get-Content compose/opensearch/opensearch.env | ForEach-Object {
#     if ($_ -match '^\s*([^#][^=]*)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1].Trim(), $matches[2].Trim()) }
#   }
# or, in bash:  set -a; . compose/opensearch/opensearch.env; set +a

# -----------------------------------------------------------------------------
# Ingest client (scripts/ingest_opensearch.py)
# -----------------------------------------------------------------------------
# Host:port of OpenSearch as seen by the ingest client.
#   - From the HOST (outside compose):          localhost:9200
#   - From INSIDE the compose network (app svc): opensearch:9200
OPENSEARCH_HOST=localhost:9200

# -----------------------------------------------------------------------------
# OpenSearch service (mirrors docker-compose.yml; minimal local setup)
# -----------------------------------------------------------------------------
# Single-node, security plugin disabled for local convenience.
# DO NOT use in production.
discovery.type=single-node
DISABLE_SECURITY_PLUGIN=true
DISABLE_INSTALL_DEMO_CONFIG=true
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
