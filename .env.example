# OpenSearch and OpenSearch Dashboards image tag.
OPENSEARCH_VERSION=2.17.1
# Host port for the OpenSearch REST API.
OPENSEARCH_PORT=9200
# Host port for OpenSearch Dashboards.
OPENSEARCH_DASHBOARDS_PORT=5601
# JVM heap for the single OpenSearch node (used for both -Xms and -Xmx).
OPENSEARCH_HEAP=2g
# Host:port used by scripts/ingest_opensearch.py.
OPENSEARCH_HOST=localhost:9200
# Optional override of the data directory (default: ./data).
INSIDER_THREAT_DATA=
