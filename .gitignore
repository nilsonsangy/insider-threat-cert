# CERT dataset downloaded into data/ - never versioned (ExactData/CMU license).
# Code and scripts are versioned; the data is NOT.
/data/*
!/data/.gitkeep

# Bytecode and caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# Build/packaging
build/
dist/
*.egg-info/

# Local runs / outputs
*.log
.DS_Store
